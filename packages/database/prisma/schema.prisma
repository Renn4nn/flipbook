// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Document {
  id        String   @id @default(uuid())
  filename  String
  path      String
  title     String?
  size      String
  pages     Int
  isPublic  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ownerId   String
  owner     User     @relation("DocumentOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  users     User[]   @relation("DocumentToUser")

  @@index([ownerId])
}

model User {
  id             String     @id @default(uuid())
  login          String     @unique
  password       String
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  documents      Document[] @relation("DocumentToUser")
  ownedDocuments Document[] @relation("DocumentOwner")
}
